static func text_width(text: String, px: int) -> int:
	if text.is_empty():
		return 0
	return (text.length() * ADVANCE - 1) * px


## Draws text with its top-left at pos. px = screen pixels per font pixel.
static func draw_text(ci: CanvasItem, pos: Vector2, text: String, color: Color, px: int) -> void:
	var x := pos.x
	for ch in text:
		var glyph = GLYPHS.get(ch)
		if glyph != null:
			for r in GLYPH_H:
				var bits: int = glyph[r]
				var c := 0
				while c < GLYPH_W:
					if bits & (1 << (GLYPH_W - 1 - c)):
						var run := 1
						while c + run < GLYPH_W and bits & (1 << (GLYPH_W - 1 - c - run)):
							run += 1
						ci.draw_rect(Rect2(x + c * px, pos.y + r * px, run * px, px), color)
						c += run
					else:
						c += 1
		x += ADVANCE * px
