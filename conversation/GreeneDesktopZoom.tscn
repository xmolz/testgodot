[sub_resource type="Shader" id="Shader_circle_mask"]
code = "shader_type canvas_item;

// step 2.194: crops the avatar to a circle (soft 1% edge).
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	float d = distance(UV, vec2(0.5));
	c.a *= 1.0 - smoothstep(0.49, 0.5, d);
	COLOR = c * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_circle_mask"]
shader = SubResource("Shader_circle_mask")

