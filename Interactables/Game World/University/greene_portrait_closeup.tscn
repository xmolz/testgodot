script = ExtResource("1_script")
professor_name = "Dr. Alan Greene"
subtitle = "Ph.D., Molecular Genetics"
lab_line = "Head, Genomics Laboratory · Greendale University"
born_line = "Born 09/03/1962 · Sacramento, California"
body_text = "Joined Greendale in 2004. Known for inspiring his students and everyone who’s had the chance to work alongside him. The most cited professor in his field of genomics, and a brilliant teacher."
quote_text = "\"No such thing as a stupid question!\""
dedication = "Portrait commissioned by the Genomics Graduate Association, 2021"
panel_tint = Color(0.78, 0.85, 0.83, 1)

