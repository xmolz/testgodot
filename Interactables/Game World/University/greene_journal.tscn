[sub_resource type="Resource" id="Resource_journal_examine"]
script = ExtResource("2_response")
verb_id = "examine"
actions_to_perform = Array[ExtResource("3_action")]([SubResource("Resource_open_journal")])

[sub_resource type="Resource" id="Resource_journal_use"]
script = ExtResource("2_response")
verb_id = "use"
actions_to_perform = Array[ExtResource("3_action")]([SubResource("Resource_open_journal")])

[node name="GreeneJournal" type="Area2D"]
script = ExtResource("1_interactable")
