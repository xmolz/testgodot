[sub_resource type="ShaderMaterial" id="ShaderMaterial_journal_outline"]
resource_local_to_scene = true
shader = ExtResource("7_outline")
shader_parameter/enable_outline = true
shader_parameter/outline_color = Color(0.2, 0.85, 1, 1)
shader_parameter/outline_width = 12.0

[sub_resource type="Resource" id="Resource_open_journal"]
script = ExtResource("4_journal_action")
