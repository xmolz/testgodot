@tool
extends Button


signal resource_dropped(next_resource: Resource)


var resource: Resource:
	set(next_resource):
		resource = next_resource
		if resource:
			icon = DMPlugin.instance._get_plugin_icon()
			text = resource.resource_path.get_file().replace(".dialogue", "")
		else:
			icon = null
			text = "<empty>"
	get:
