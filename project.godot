ConversationEventManager="*res://autoload/ConversationEventManager.gd"
FallbackManager="*res://autoload/FallbackManager.gd"
NotificationManager="*res://autoload/NotificationManager.tscn"

[dialogue_manager]

runtime/balloon_path="uid://dmfq0fjxxjgay"

