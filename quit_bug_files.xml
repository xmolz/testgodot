func _ready():
	if is_instance_valid(darken_backdrop):
		darken_backdrop.mouse_filter = Control.MOUSE_FILTER_STOP
	if is_instance_valid(solid_background):
		solid_background.mouse_filter = Control.MOUSE_FILTER_STOP

