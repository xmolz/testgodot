	=> END
else:
	Player: (Wait... Something's happening to him.)

# This command reaches into the main scene and forces his state to 2 (INVIGIROL/Hyper)
do GameManager.main_game_scene_instance.get_node("McBucket_Path/McBucket").change_state(2)

=> END

