# --- EXAMPLES OF HOW TO USE THIS FILE ---

~ mcbucket_pre

if Flags.get_level_flag("mcbucket_cannathink_used"):
	Player: (Flash? This Old stoner?)
	Player: (Hmm. Why not. Let's see how he reacts.)
	=> END

else:
	Player: (Flash? This old fossil?)
	Player: (Hmm. Why not. Might be a cool experiment.)
=> END

~ mcbucket_post

if Flags.get_level_flag("mcbucket_zanopram_used"):
	Player: (Yeah... don't know what I was expecting to happen.)
	Player: (Dangling a carrot in front of a sleeping rabbit like that.)
	=> END
elif Flags.get_level_flag("mcbucket_invigirol_used"):
	=> default_post
elif Flags.get_level_flag("mcbucket_cannathink_used"):
	Old Man: Aphrodite? Ye almighty Aphrodite?
	Old Man: Ye bless me with yer presence?
	Player: (That's... flattering.)
	=> END
else:
	Player: (Wait... Something's happening to him.)

# This requests the state change via the ConversationEventManager bus to force his state to 2 (INVIGIROL/Hyper)
do ConversationEventManager.request_mcbucket_state(2)
do Flags.set_level_flag("mcbucket_state_from_flash", true)

=> END

