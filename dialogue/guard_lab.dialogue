~ jayce_keycard_blackmail
# step 2.275: the blackmail route, with jayce's camera in hand. he unlocks dr. greene's office and leaves
# for the day. sets jayce_camera_seen (chapter memory -> kb_jayce_camera_seen for the car ride),
# greene_office_unlocked and jayce_gone. fiona keeps the camera.
do actor_change("Jayce", "base")
do actor_change("Fiona", "suspicious")
Player: Well, you don't have much of a choice, you see?
# step 2.374: Layla enjoys this (a smug side glance)
do actor_change("Layla", "smug")
# step 2.396: the camera comes out and his theme stops dead, with a record winding down (on the music bus,
# so it sits at the music's level). the silence holds until he leaves.
do SoundManager.cut_music()
do SoundManager.play_sfx("vinyl_stop", 1.0, 0.0, "Main Music")
do actor_change("Fiona", "explain")
# step 2.404: the camera, held up beside her until he gives in
do actor_item("Fiona", "camera")
Player: We did some looking around, and we came across this lil thing.
do actor_change("Jayce", "sorry")
do actor_change("Fiona", "suspicious")
Player: We know what's in it, and we know what kind of a man you are.
Player: So here is what you're gonna do now.
Player: You're gonna go up and unlock that door for us.
Player: And then, you'll end your shift and go home.
Player: 'Cause frankly, I've had enough of your fucking bullshit, Jayce.
Jayce takes a long pause.
do actor_change("Jayce", "sorry_talk")
Jayce: Sure. I'll do that.
Jayce: Just... don't go showin' that to nobody now, will ya?
do actor_change("Jayce", "sorry")
do actor_change("Fiona", "base")
do actor_item_hide("Fiona")
Player: On your way, Jayce.
do Flags.set_level_flag("jayce_gone", true)
# step 2.396: nothing is playing after the record scratch; this brings the corridor's ambience back up
do SoundManager.fade_out_music(2.0)
do party_dismiss()
Jayce slips away silently.
do Flags.set_level_flag("jayce_camera_seen", true)
do Flags.set_level_flag("greene_office_unlocked", true)
do Flags.set_level_flag("greene_office_entry_pending", true)
if Flags.get_level_flag("party_companion_staged") == true:
	if Flags.get_game_counter("layla_closeness") < 0:
		do actor_change("Layla", "talking")
		Layla: ...Good. He had it coming.
		do actor_change("Layla", "neutral")
		do actor_change("Fiona", "shrug")
		Player: I just did what I had to do to get things going our way, Layla.
		Player: If something else was required, I would've done that too.
		do actor_change("Layla", "hesitant")
		Layla: ...Thanks. For doing that.
		do actor_change("Layla", "touched")
		do actor_change("Fiona", "base")
		Player: Don't mention it.
		Player: Anyway, let's go?
		do actor_change("Layla", "hesitant")
		Layla: Let's go.
	else
		do actor_change("Layla", "excited")
		do actor_effect("Layla", "jump")
		Layla: Fiona! Wow! That was amazing!
		Layla: You've really taught him a lesson!
		do actor_change("Layla", "eager")
		do actor_change("Fiona", "shrug")
		Player: I just did what I had to do to get things going our way, Layla.
		Player: If something else was required, I would've done that too.
		if Flags.get_game_counter("layla_closeness") >= 3:
			do actor_change("Layla", "admiring")
			Layla: You're...
			do actor_change("Layla", "warm")
			do actor_change("Fiona", "suspicious")
			Player: Sorry?
			# happy tears with her blush, then the same with her mouth shut while Fiona answers
			do actor_change("Layla", "happy_tears")
			Layla: You're the most amazing person ever, Fiona.
			do actor_change("Layla", "teary_smile")
			Player: Doubt it.
		else
			do actor_change("Layla", "admiring")
			Layla: That was... really something, Fiona.
			do actor_change("Layla", "warm")
			do actor_change("Fiona", "base")
			Player: Heh. If you say so.
		do actor_change("Fiona", "base")
		Player: Anyway, let's go?
		do actor_change("Layla", "excited")
		Layla: Let's go!
else
	# step 2.227: no solo playthrough (Layla is always with Fiona). fallback only, so the branch stays valid.
	Player: This is a template line.
=> END

~ jayce_keycard_other_way
# step 2.276: no camera yet. fiona backs off; she and layla decide to find dirt on him.
# sets jayce_keycard_refused (hub: "Show him his camera." once they carry it).
do actor_change("Jayce", "base")
do actor_change("Fiona", "suspicious")
Player: (I don't like his tone...)
do actor_change("Fiona", "base")
Player: You know what? Never mind.
Player: I'll be back in a bit, probably.
do actor_change("Jayce", "talk")
Jayce: I'll be waitin'.
do SoundManager.fade_out_music(2.0)
do party_dismiss()
do Flags.set_level_flag("jayce_keycard_refused", true)
if Flags.get_level_flag("party_companion_staged") == true:
	if Flags.get_game_counter("layla_closeness") < 0:
		do actor_change("Layla", "sad")
		Layla: Doesn't look like he's gonna help us.
		do actor_change("Layla", "downcast")
	else
