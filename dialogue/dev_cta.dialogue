~ start

do set_backdrop_darkness(0.0, 0.0)

Player: I clicked on the locked level.
Player: And then, I couldn't believe what I saw.
Player: What I saw was the weirdest...
Player: The creepiest...
Player: The scariest...

do actor_enter("Lewgend", "open_arms", "center")

Lewgend: DEV INSERT!

do actor_effect("Lewgend", "shock")
do actor_change("Lewgend", "waving")

Lewgend: Hey! I'm Lewgend. How are ya?
do actor_change("Lewgend", "explaining_1")
Lewgend: Well, I've got news. Good and bad.

Lewgend: So... bad news first.
do actor_change("Lewgend", "embarrassed")
Lewgend: The demo ends here.
Lewgend: Yeah. I know. Bummer.

do actor_effect("Lewgend", "shock")
do actor_change("Lewgend", "open_arms")

Lewgend: But, good news?
do actor_change("Lewgend", "determined")
Lewgend: Your boy is COOKING.
Lewgend: COOKING so much! I've so much planned for this game!

do actor_change("Lewgend", "explaining_2")
Lewgend: For example:
Lewgend: Lemme call our first female love interest... Layla!
Lewgend: Layla! Get over here would ya?

# Lewgend slides to the right slot, making room!
do actor_move("Lewgend", "right")

# Layla slides in from off-screen into the left slot!
do actor_dash_in("Layla", "victory", "left")
Layla: HEY Lew! Called me?
do actor_change("Layla", "base")
Layla: What's up? How's it going?
do actor_change("Lewgend", "waving")
Lewgend: Hey! All good, Layla! You seem upbeat today.
do actor_change("Layla", "proud")
Layla: Oh, well, you know, just trying to keep my spirits up.
do actor_change("Layla", "angry_1")
Layla: Kinda hard, though... you know?
Layla: Since you decided to give your protagonist bigger titties than me!
do actor_change("Layla", "pout")
do actor_change("Lewgend", "embarrassed")
Lewgend: ...Layla.
do actor_change("Lewgend", "explaining_2")
Lewgend: Do we really need to do this right now?
do actor_change("Lewgend", "hand_on_chest")
Lewgend: We're creating a body-positive game! Everybody is built differently, you know?
do actor_change("Layla", "angry_1")
Layla: Whatever. I hope you compensate for this atrocity by giving me a damn good character arc.
do actor_change("Lewgend", "explaining_3")
Lewgend: Oh, you bet!
do actor_change("Lewgend", "determined")
Lewgend: Creating a rich world with interesting characters is the primary goal of this game!
do actor_change("Layla", "base")
Layla: M'kay.
do actor_flip("Layla", true)
Layla: Anyway, bye now.

# Layla walks off-screen to the left (the way she came in)
do actor_walk_out("Layla", "left")

# Lewgend smoothly slides back to the center of the screen
do actor_move("Lewgend", "center")

Lewgend: Hah. Classic Layla. She really is something.

Lewgend: But hey! Let's not forget about our first male love interest... Malcolm!
do actor_change("Lewgend", "hand_on_chest")
do actor_flip("Lewgend", true)
Lewgend: Malcolm, get in here my man.

do actor_peek_in("Malcolm", "base", "right")
Malcolm: You sure about that?
Malcolm: Last time we discussed this, you said I wasn't ready to be shown.

do actor_focus("Lewgend", 2.2, 0.05)
Lewgend: ...

do actor_focus("Malcolm", 2.2, 0.05, 0.10)
Malcolm: ...

do actor_focus("Lewgend", 3.0, 0.05)
Lewgend: ...

do actor_unfocus_all(0.0)
Lewgend: Well... you know what? Never mind.

# Trigger the new tackle animation!
do actor_tackle("Lewgend", "Malcolm")
Malcolm: [wave amp=50.0 freq=5.0 connected=1][speed=0.25]Nooooooooooooooo![/speed][/wave]

# Reset Lewgend so he faces forward again
do actor_flip("Lewgend", false)
do actor_change("Lewgend", "embarrassed")
Lewgend: I forgot I was using a template sprite for him. Hehe.

do actor_change("Lewgend", "open_arms")
Lewgend: But worry not! We plan on having multiple polished love interests in the game!

do actor_change("Lewgend", "explaining_1")
Lewgend: I'm sure he'll be in a much better state by the time of the next release.

do actor_change("Lewgend", "determined")
Lewgend: But hey, regarding that...
Lewgend: Making this game has been really fun! It's taught me so much.

do actor_change("Lewgend", "hand_on_chest")
Lewgend: But if I am to continue making this game... I'll need your support.
Lewgend: I want to form a team! With artists, sound designers, programmers, and animators!

do actor_change("Lewgend", "embarrassed")
Lewgend: But as it stands, I'm too broke to do that right now. Hehe.

do actor_change("Lewgend", "explaining_3")
Lewgend: So, it would mean the world to me if you could lend me your support!

# Slide Lewgend center-right and drop the Patreon Button!
do actor_move("Lewgend", "center_right", 0.5)
do show_patreon_button()

do actor_change("Lewgend", "open_arms")
Lewgend: The best way to support would be to subscribe to my Patreon!

do actor_change("Lewgend", "determined")
Lewgend: Patrons get the newest version of the game AS SOON as it's ready!
Lewgend: No waiting around!
Lewgend: Plus sneak peeks, development updates, and other fun lil' goodies along the way.

do actor_change("Lewgend", "hand_on_chest")
Lewgend: And hey... if money happens to be a bit tight right now?

do actor_change("Lewgend", "explaining_1")
Lewgend: I get it. We've all been there.

do actor_change("Lewgend", "waving")
Lewgend: You can still join the Patreon as a free member!
Lewgend: It genuinely helps out a ton, too.

do actor_change("Lewgend", "explaining_3")
Lewgend: You'll get access to public releases, updates, and stay in the loop as this weird little project grows.

do actor_change("Lewgend", "open_arms")
Lewgend: Anyway, that's all I had to say.
Lewgend: If you liked the demo, you'll definitely be seeing more of me!

do actor_change("Lewgend", "determined")
Lewgend: I'm hoping to release the next major update within the next two months.

do actor_change("Lewgend", "embarrassed")
Lewgend: Wish me luck! I'm going to give it everything I've got.

do actor_change("Lewgend", "hand_on_chest")
Lewgend: Truly, thank you for taking the time to play my game!

do actor_change("Lewgend", "waving")
Lewgend: Toodles!

# Animate the button to the bottom center and lock it to the Memory Box!
do center_patreon_button_and_keep_alive()

# Hide the text box and the actor so the button is front and center
do hide_dialogue_ui()
do actor_leave("Lewgend")
do Flags.set_level_flag("dev_cta_completed", true)
=> END