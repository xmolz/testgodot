~ television_screen

if Flags.get_level_flag("tv_turned_off") == false
	Player: (I'll just hit this switch here...)
	do ConversationEventManager.request_tv_state(true)
	do Flags.set_level_flag("tv_turned_off", true)
	do wait(1.0)
	if Flags.get_level_flag("mcbucket_zanopram_used") == false and Flags.get_level_flag("mcbucket_cannathink_used") == false and Flags.get_level_flag("mcbucket_invigirol_used") == false
		Player: (The TV shut off. Wait...)
		Player: (What's up with the Old Man?)
		do ConversationEventManager.request_mcbucket_tv_reaction(true)
	else
		Player: (The TV shut off.)
else
	Player: (Let's turn that back on.)
	do ConversationEventManager.request_tv_state(false)
	do Flags.set_level_flag("tv_turned_off", false)
	do wait(1.0)
	Player: (Ah, this soothing static.)
	if Flags.get_level_flag("mcbucket_zanopram_used") == false and Flags.get_level_flag("mcbucket_cannathink_used") == false and Flags.get_level_flag("mcbucket_invigirol_used") == false
		Player: (The Old Man seems to have calmed down, too.)
		do ConversationEventManager.request_mcbucket_tv_reaction(false)

=> END

